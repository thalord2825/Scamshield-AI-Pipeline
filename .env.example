# ==============================================================================
# ScamShield-VN AI Pipeline Environment Variables
# ==============================================================================

# Server configuration
PORT=8000
HOST=0.0.0.0

# Router Settings
TIER1_CONFIDENCE_THRESHOLD=0.90
USE_COUNCIL=true
VISOBERT_MODEL_DIR=models/visobert_finetuned

# Google Gemini API (Tier 2 Cloud Fallback & Forensic Council)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq Cloud API (Optional: LLaMA-3.3 / Mixtral inference)
GROQ_API_KEY=your_groq_api_key_here

# Multi-Provider / OpenAI-Compatible Proxy Keys (VIBI, OpenAI, Anthropic)
OPENAI_API_KEY=your_openai_or_vibi_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VIBI_BASE_URL=https://vibi.top/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
